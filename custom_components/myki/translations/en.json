  "services": {
    "power_off": {
      "name": "Power off tracker",
      "description": "Stop tracking and calls. Physical access is needed to power on; no remote power-on is known. Success means cloud acceptance only.",
      "fields": {
        "confirm": {
          "name": "I understand physical access is required to power the tracker back on"
        }
      }
    },
    "restart": {
      "name": "Restart tracker",
      "description": "Request a reboot, temporarily interrupting tracking and calls. Not a factory reset. Cloud acceptance does not prove reboot or configuration retention.",
      "fields": {
        "confirm": {
          "name": "I accept the interruption and can physically recover the tracker if needed"
        }
      }
    },
    "set_safe_zone": {
      "name": "Set safe zone",
      "description": "Edit one MyKi zone, preserving omitted fields. Radius in meters.",
